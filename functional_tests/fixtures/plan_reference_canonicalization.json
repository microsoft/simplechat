      "expected": "ideographic"
    },
    {
      "name": "inner spaces are kept",
      "input": "two  words",
      "expected": "two  words"
    },
    {
      "name": "markup is plain text",
      "input": "<b>markup</b> & \"quotes\"",
      "expected": "<b>markup</b> & \"quotes\""
    },
    {
