{
  "title": "Document Search Settings",
  "description": "Default search, windowing, and summarization settings for SimpleChat internal document search.",
  "type": "object",
  "properties": {
    "default_doc_scope": {
      "type": "string",
      "enum": [
        "all",
        "personal",
        "group",
        "public"
      ],
      "default": "all"
    },
    "allowed_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "personal",
          "group",
          "public"
        ]
      },
      "uniqueItems": true,
      "default": [
        "personal",
        "group",
        "public"
      ]
    },
    "allowed_group_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "allowed_public_workspace_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "default_top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    },
    "default_window_unit": {
      "type": "string",
      "enum": [
        "pages",
        "chunks"
      ],
      "default": "pages"
    },
    "default_window_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "default_window_percent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "default_focus_instructions": {
      "type": "string"
    },
    "default_window_target_length": {
      "type": "string",
      "default": "2 pages"
    },
    "default_final_target_length": {
      "type": "string",
      "default": "2 pages"
    }
  }
}