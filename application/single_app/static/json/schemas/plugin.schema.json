{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Plugin",
  "definitions": {
    "AuthType": {
      "type": "string",
      "enum": [
        "NoAuth",
        "key",
        "identity",
        "user",
        "servicePrincipal",
        "connection_string",
        "basic",
        "username_password"
      ],
      "description": "Supported authentication types for plugins."
    },
    "Plugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Plugin unique identifier (UUID)"
        },
        "user_id": {
          "type": "string",
          "description": "User ID that owns this personal plugin"
        },
        "last_updated": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Alphanumeric, underscore, and dash only"
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable display name for the plugin"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "is_enabled": {
          "type": "boolean",
          "description": "False when the action is hidden from runtime use but retained for admin management.",
          "default": true
        },
        "identity_id": {
          "type": "string",
          "description": "Workspace identity reference used by this action. Credentials are resolved server-side within the action scope."
        },
        "credential_requirement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Server-owned stable requirement identifier."
            },
            "source": { "const": "current_user" },
            "identity_name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "profile": {
              "enum": ["yamcs_login", "http_basic", "bearer_token", "api_key"]
            }
          },
          "required": ["source", "identity_name", "profile"],
          "description": "Non-secret requirement for the submitting user's private personal identity."
        },
        "endpoint": {
          "type": "string"
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/definitions/AuthType",
              "description": "Auth type must be one of the supported authentication modes."
            },
            "key": {
              "type": "string",
              "description": "The secret value for the plugin should be stored here, such as a SQL connection string, a password for a service principal or username/password combination"
            },
            "identity": {
              "type": "string",
              "description": "This could be the Id of an (managed) identity, a user name, or similar to pair with the key, in most situations"
            },
            "tenantId": {
              "type": "string",
              "description": "The Azure AD tenant ID used with Service Principal authentication"
            }
          },
          "additionalProperties": false,
          "required": ["type"]
        },
        "metadata": {
          "type": "object",
          "description": "Arbitrary metadata",
          "additionalProperties": true
        },
        "additionalFields": {
          "type": "object",
          "description": "Additional fields for plugin configuration based on plugin type. See plugin documentation for details. Any fields named __Secret (double underscore) will be stored in key vault if the feature is enabled.",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": { "required": ["credential_requirement"] },
          "then": {
            "properties": {
              "type": { "const": "yamcs" },
              "auth": {
                "properties": {
                  "key": { "const": "" },
                  "identity": { "const": "" },
                  "tenantId": { "const": "" }
                }
              },
              "identity_id": { "const": "" }
            }
          },
          "else": {
            "properties": {
              "auth": {
                "allOf": [
                  { "if": { "properties": { "type": { "const": "key" } } }, "then": { "required": ["key"] } },
                  { "if": { "properties": { "type": { "const": "identity" } } }, "then": { "required": ["identity"] } },
                  { "if": { "properties": { "type": { "const": "servicePrincipal" } } }, "then": { "required": ["tenantId", "identity", "key"] } },
                  { "if": { "properties": { "type": { "const": "connection_string" } } }, "then": { "required": ["key"] } },
                  { "if": { "properties": { "type": { "const": "basic" } } }, "then": { "required": ["key", "identity"] } },
                  { "if": { "properties": { "type": { "const": "username_password" } } }, "then": { "required": ["key", "identity"] } }
                ]
              }
            }
          }
        }
      ],
      "required": ["name", "type", "description", "endpoint", "auth", "metadata", "additionalFields"],
      "title": "Plugin"
    }
  }
}
