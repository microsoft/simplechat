{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Microsoft Learn MCP Preconfiguration Settings",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contentFocus",
        "publicDocumentationOnly",
        "preferredTools"
    ],
    "properties": {
        "contentFocus": {
            "type": "string",
            "enum": ["all_microsoft", "azure"]
        },
        "publicDocumentationOnly": {
            "type": "boolean",
            "const": true
        },
        "preferredTools": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
                "type": "string",
                "enum": [
                    "microsoft_docs_search",
                    "microsoft_docs_fetch",
                    "microsoft_code_sample_search"
                ]
            }
        }
    }
}
