{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GitHub MCP Preconfiguration Settings",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "hostedServer",
        "permissionModel",
        "recommendedCredentialHandling"
    ],
    "properties": {
        "hostedServer": {
            "type": "boolean",
            "const": true
        },
        "permissionModel": {
            "type": "string",
            "enum": ["supplied_identity_permissions"]
        },
        "recommendedCredentialHandling": {
            "type": "string",
            "enum": ["least_privilege_pat_or_identity"]
        },
        "defaultRepositoryScope": {
            "type": "string",
            "enum": ["user_selected"]
        }
    }
}
