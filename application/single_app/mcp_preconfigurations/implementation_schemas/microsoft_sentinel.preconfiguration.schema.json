{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Microsoft Sentinel MCP Preconfiguration Settings",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "dataSensitivity",
        "defaultAccessMode",
        "requiredProducts",
        "toolCollections"
    ],
    "properties": {
        "dataSensitivity": {
            "type": "string",
            "enum": ["high"]
        },
        "defaultAccessMode": {
            "type": "string",
            "enum": ["read_only"]
        },
        "requiredProducts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
                "type": "string",
                "enum": [
                    "microsoft_sentinel_data_lake",
                    "microsoft_defender",
                    "microsoft_security_copilot_optional"
                ]
            }
        },
        "toolCollections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
                "type": "string",
                "enum": [
                    "incidents_read",
                    "alerts_read",
                    "entities_read",
                    "hunting_read"
                ]
            }
        }
    }
}
