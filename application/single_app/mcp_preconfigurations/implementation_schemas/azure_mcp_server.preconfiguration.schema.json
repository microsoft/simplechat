{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Azure MCP Server Preconfiguration Settings",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "defaultAccessMode",
        "localCommandExecution",
        "organizationHostedRemoteRequired",
        "serviceNamespaces"
    ],
    "properties": {
        "defaultAccessMode": {
            "type": "string",
            "enum": ["read_only"]
        },
        "localCommandExecution": {
            "type": "boolean",
            "const": false
        },
        "organizationHostedRemoteRequired": {
            "type": "boolean",
            "const": true
        },
        "serviceNamespaces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$"
            }
        }
    }
}
