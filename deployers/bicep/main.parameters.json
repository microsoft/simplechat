{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "webSearchProvider": { "value": "${WEB_SEARCH_PROVIDER=preserve}" },
    "webIqResourceMode": { "value": "${WEB_IQ_RESOURCE_MODE=create}" },
    "existingWebIqName": { "value": "${EXISTING_WEB_IQ_NAME=}" },
    "existingWebIqResourceGroup": { "value": "${EXISTING_WEB_IQ_RESOURCE_GROUP=}" },
    "existingWebIqSubscriptionId": { "value": "${EXISTING_WEB_IQ_SUBSCRIPTION_ID=}" },
    "contentUnderstandingMode": { "value": "${CONTENT_UNDERSTANDING_MODE=preserve}" },
    "contentUnderstandingLocation": { "value": "${CONTENT_UNDERSTANDING_LOCATION=}" },
    "existingContentUnderstandingName": { "value": "${EXISTING_CONTENT_UNDERSTANDING_NAME=}" },
    "existingContentUnderstandingResourceGroup": { "value": "${EXISTING_CONTENT_UNDERSTANDING_RESOURCE_GROUP=}" },
    "existingContentUnderstandingSubscriptionId": { "value": "${EXISTING_CONTENT_UNDERSTANDING_SUBSCRIPTION_ID=}" },
    "contentUnderstandingModels": { "value": "${CONTENT_UNDERSTANDING_MODELS=[]}" },
    "optionalServicesDeploymentPrincipalId": { "value": "${OPTIONAL_SERVICES_DEPLOYMENT_PRINCIPAL_ID=}" },

    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "redisLocation": {
      "value": "${REDIS_LOCATION}"
    },
    "cloudEnvironment": {
      "value": "${env_AZURE_CLOUD_ENVIRONMENT}"
    },
    "appName": {
      "value": "${env_DEPLOYMENT_APPNAME}"
    },
    "environment": {
      "value": "${environment}"
    },
    "azdEnvironmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "imageName": {
      "value": "${CONTAINER_IMAGE_NAME}"
    },
    "deployNativePythonWebApp": {
      "value": "${DEPLOY_NATIVE_PYTHON_WEBAPP}"
    },
    "nativeWebAppName": {
      "value": "${NATIVE_WEBAPP_NAME}"
    },
    "deployV2FrontendAppService": {
      "value": "${DEPLOY_V2_FRONTEND_APP_SERVICE}"
    },
    "v2WebAppName": {
      "value": "${V2_WEBAPP_NAME}"
    },
    "enterpriseAppClientId": {
      "value": "${ENTERPRISE_APP_CLIENT_ID}"
    },
    "enterpriseAppServicePrincipalId": {
      "value": "${ENTERPRISE_APP_SERVICE_PRINCIPAL_ID}"
    },
    "enterpriseAppClientSecret": {
      "value": "${ENTERPRISE_APP_CLIENT_SECRET}"
    },
    "authenticationType": {
      "value": "${AUTHENTICATION_TYPE}"
    },
    "redisAuthenticationType": {
      "value": "${REDIS_AUTHENTICATION_TYPE}"
    },
    "configureApplicationPermissions": {
      "value": "${CONFIGURE_APPLICATION_PERMISSIONS}"
    },    
    "specialTags": {
      "value": {
        "Project": "SimpleChat"
      }
    },
    "enableDiagLogging": {
      "value": "${ENABLE_DIAG_LOGGING}"
    }, 
    "enablePrivateNetworking": {
      "value": "${ENABLE_PRIVATE_NETWORKING}"
    },
    "enableAzureMonitorPrivateLink": {
      "value": "${ENABLE_AZURE_MONITOR_PRIVATE_LINK=false}"
    },
    "existingVirtualNetworkId": {
      "value": "${EXISTING_VNET_RESOURCE_ID}"
    },
    "existingAppServiceSubnetId": {
      "value": "${EXISTING_APP_SERVICE_SUBNET_RESOURCE_ID}"
    },
    "existingPrivateEndpointSubnetId": {
      "value": "${EXISTING_PRIVATE_ENDPOINT_SUBNET_RESOURCE_ID}"
    },
    "privateDnsZoneConfigs": {
      "value": "${PRIVATE_DNS_ZONE_CONFIGS}"
    },
    "existingOpenAIEndpoint": {
      "value": "${EXISTING_AZURE_OPENAI_ENDPOINT}"
    },
    "customVideoIndexerArmApiVersion": {
      "value": "${CUSTOM_VIDEO_INDEXER_ARM_API_VERSION}"
    },
    "customVideoIndexerEndpoint": {
      "value": "${CUSTOM_VIDEO_INDEXER_ENDPOINT}"
    },
    "existingOpenAIResourceName": {
      "value": "${EXISTING_AZURE_OPENAI_RESOURCE_NAME}"
    },
    "existingOpenAIResourceGroup": {
      "value": "${EXISTING_AZURE_OPENAI_RESOURCE_GROUP}"
    },
    "existingOpenAISubscriptionId": {
      "value": "${EXISTING_AZURE_OPENAI_SUBSCRIPTION_ID}"
    },
    "openAIDeploymentType": {
      "value": "${OPENAI_DEPLOYMENT_TYPE}"
    },
    "gptModels": {
      "value": "${GPT_MODELS}"
    },
    "embeddingModels": {
      "value": "${EMBEDDING_MODELS}"
    },
    "allowedIpAddresses": {
      "value": "${ALLOWED_IP_RANGES}"
    },
    "deployContentSafety": {
      "value": "${DEPLOY_CONTENT_SAFETY}"
    },
    "deployRedisCache": {
      "value": "${DEPLOY_REDIS_CACHE}"
    },
    "redisCacheKind": {
      "value": "${REDIS_CACHE_KIND}"
    },
    "redisManagedSkuName": {
      "value": "${REDIS_MANAGED_SKU_NAME}"
    },
    "redisHighAvailability": {
      "value": "${REDIS_HIGH_AVAILABILITY}"
    },
    "redisClusteringPolicy": {
      "value": "${REDIS_CLUSTERING_POLICY}"
    },
    "deploySpeechService": {
      "value": "${DEPLOY_SPEECH_SERVICE}"
    },
    "deployVideoIndexerService": {
      "value": "${DEPLOY_VIDEO_INDEXER_SERVICE}"
    },
    "videoIndexerLocation": {
      "value": "${VIDEO_INDEXER_LOCATION}"
    }
  }
}